# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=playflix

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# TMDB API (Get from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your-tmdb-api-key-here

# Fanart.tv API (Get from https://fanart.tv/get-an-api-key/)
FANART_API_KEY=your-fanart-tv-api-key-here

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRY=1d

# Admin Panel Credentials
# These are used to seed + authenticate the built-in admin-panel user.
# On module init, AuthService ensures a panel admin user exists in the DB
# using the email/password below, and keeps the DB password in sync.
# Defaults: admin / admin / admin@playflix.local
ADMIN_PANEL_USER=admin
ADMIN_PANEL_PASSWORD=admin
ADMIN_PANEL_EMAIL=admin@playflix.local

# Server
PORT=3002
NODE_ENV=development
